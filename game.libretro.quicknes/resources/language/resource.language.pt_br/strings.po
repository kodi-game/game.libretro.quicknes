msgstr "Metálico"

msgctxt "#30050"
msgid "Enables the use of the Turbo A and Turbo B buttons."
msgstr "Habilita o uso dos botões de Turbo A e Turbo B."

msgctxt "#30051"
msgid "None"
msgstr "Nenhum"

msgctxt "#30052"
msgid "Player 1"
msgstr "Jogador 1"

msgctxt "#30053"
