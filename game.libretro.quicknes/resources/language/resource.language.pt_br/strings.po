msgctxt "Addon Summary"
msgid "Nintendo - NES / Famicom (QuickNES)"
msgstr ""

msgctxt "Addon Description"
msgid "A port of the QuickNES core library, originally by Shay Green, heavily modified. QuickNES is a newer emulator that seems to have good compatibility."
msgstr ""

msgctxt "#30001"
msgid "Aspect Ratio"
msgstr "Proporção de tela"

msgctxt "#30002"
msgid "Show Horizontal Overscan"
msgstr "Mostrar overscan horizontal"

msgctxt "#30003"
msgid "Show Vertical Overscan"
msgstr "Mostrar overscan vertical"

msgctxt "#30004"
msgid "Color Palette"
msgstr "Paleta de cores"

msgctxt "#30005"
msgid "No Sprite Limit"
msgstr "Sem limite de sprite"

msgctxt "#30006"
msgid "Audio Mode"
msgstr "Modo de áudio"

msgctxt "#30007"
msgid "Audio Equalizer Preset"
msgstr "Predefinição do equalizador de áudio"

msgctxt "#30008"
msgid "Turbo Enable"
msgstr "Ativa o turbo"

msgctxt "#30009"
msgid "Turbo Pulse Width (in frames)"
msgstr "Comprimento do pressionamento do turbo (em quadros)"

msgctxt "#30010"
msgid "Allow Opposing Directions"
msgstr "Permite direções contrárias"

msgctxt "#30011"
msgid "Sound Samplerate (Hint)"
msgstr ""

msgctxt "#30012"
msgid "This will only apply when RetroArch's aspect ratio is set to 'Core provided' in the Video settings."
msgstr "Isto só se aplicará quando a proporção de tela do RetroarArch estiver definida como 'Fornecida pelo núcleo' nas configurações de vídeo."

msgctxt "#30013"
msgid "Disable this to crop out (horizontally) the potentially random glitchy video output that would have been hidden by the bezel around the edge of a standard-definition television screen."
msgstr "Desabilite esta opção para cortar (a parte horizontal) dos possíveis defeitos visuais aleatórios no vídeo que normalmente seriam escondidos pelo enquadramento de uma televisão de definição padrão."

msgctxt "#30014"
msgid "Disable this to crop out (vertically) the potentially random glitchy video output that would have been hidden by the bezel around the edge of a standard-definition television screen."
msgstr "Desabilite esta opção para cortar (a parte vertical) dos possíveis defeitos visuais aleatórios no vídeo que normalmente seriam escondidos pelo enquadramento de uma televisão de definição padrão."

msgctxt "#30015"
msgid "Specifies which color palette to use when decoding the NTSC video signal output by the NES."
msgstr "Especifica qual paleta de cores será usada ao decodificar o sinal de vídeo NTSC pelo NES."

msgctxt "#30016"
msgid "Default"
msgstr "Padrão"

msgctxt "#30017"
